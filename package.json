{
  "name": "gh-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub Copilot 稼働ダッシュボード / プロジェクトダッシュボード (Windows 常駐)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "rs:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rs:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rs:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rs:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "verify": "npm run typecheck && npm run test && npm run rs:test && npm run docs:check",
    "docs:build": "node tools/md2doc.mjs",
    "docs:check": "node tools/md2doc.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
